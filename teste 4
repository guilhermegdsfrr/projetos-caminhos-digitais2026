<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gildo Lanche</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- CABEÇALHO -->
    <header class="topo">
        <div class="topo-tudo">
            <h2 class="marca">Gildo Lanche</h2>

            <nav class="menu">
                <a href="#cardapio">Cardápio</a>
                <a href="#sobre">Sobre</a>
                <a href="#contato">Contato</a>
            </nav>
        </div>
    </header>

    <main>

        <!-- APRESENTAÇÃO -->
        <section class="apresentacao">
            <div class="caixa">
                <h1>Os melhores lanches da cidade do Recife!</h1>
                <p>Qualidade, sabor e carinho em cada lanche.</p>

                <a href="#cardapio" class="botao">
                    Ver Cardápio
                </a>
            </div>
        </section>


        <!-- CARDÁPIO -->
        <section id="cardapio" class="cardapio">

            <div class="caixa">
                <h2 class="titulo-secao">Cardápio</h2>

                <div class="produtos">

                    <!-- PRODUTO 1 -->
                    <div class="produto">
                        <img src="image.png" alt="Coxinha de frango">

                        <div class="produto-conteudo">
                            <h3>Coxinha</h3>
                            <p>Coxinha de frango crocante</p>

                            <div class="produto-rodape">
                                <span class="preco">R$ 10,00</span>
                                <a href="#" class="botaocompra">Pedir</a>
                            </div>
                        </div>
                    </div>


                    <!-- PRODUTO 2 -->
                    <div class="produto">
                        <img src="bolo.png" alt="Fatia de bolo de chocolate">

                        <div class="produto-conteudo">
                            <h3>Fatia de bolo de chocolate</h3>
                            <p>Bolo de chocolate com cobertura</p>

                            <div class="produto-rodape">
                                <span class="preco">R$ 15,00</span>
                                <a href="#" class="botaocompra">Pedir</a>
                            </div>
                        </div>
                    </div>


                    <!-- PRODUTO 3 -->
                    <div class="produto">
                        <img src="enroladinho.png" alt="Enroladinho de salsicha">

                        <div class="produto-conteudo">
                            <h3>Enroladinho</h3>
                            <p>Enroladinho de salsicha</p>

                            <div class="produto-rodape">
                                <span class="preco">R$ 8,00</span>
                                <a href="#" class="botaocompra">Pedir</a>
                            </div>
                        </div>
                    </div>


                    <!-- PRODUTO 4 -->
                    <div class="produto">
                        <img src="risole.png" alt="Risole misto">

                        <div class="produto-conteudo">
                            <h3>Risole</h3>
                            <p>Risole misto</p>

                            <div class="produto-rodape">
                                <span class="preco">R$ 6,00</span>
                                <a href="#" class="botaocompra">Pedir</a>
                            </div>
                        </div>
                    </div>


                    <!-- PRODUTO 5 -->
                    <div class="produto">
                        <img src="pastel.png" alt="Pastel">

                        <div class="produto-conteudo">
                            <h3>Pastel</h3>
                            <p>Pastel de queijo e presunto</p>

                            <div class="produto-rodape">
                                <span class="preco">R$ 10,00</span>
                                <a href="#" class="botaocompra">Pedir</a>
                            </div>
                        </div>
                    </div>


                    <!-- PRODUTO 6 -->
                    <div class="produto">
                        <img src="image.png" alt="Coxinha de frango">

                        <div class="produto-conteudo">
                            <h3>Coxinha</h3>
                            <p>Coxinha de frango crocante</p>

                            <div class="produto-rodape">
                                <span class="preco">R$ 10,00</span>
                                <a href="#" class="botaocompra">Pedir</a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </section>


        <!-- SOBRE -->
        <section id="sobre" class="sobre">

            <div class="caixa sobre-conteudo">

                <img src="logo.png" alt="Logo Gildo Lanche" class="logoimagem">

                <div>
                    <h2>Conheça mais sobre nossa loja</h2>

                    <p>
                        Somos a melhor lanchonete de Recife desde 2017.
                        Estamos localizados na Praça do Derby e colocamos
                        muito amor em nossos lanches.
                    </p>
                </div>

            </div>

        </section>


        <!-- CONTATO -->
        <section id="contato" class="contato">

            <div class="caixa">
                <h2>Entre em contato</h2>

                <p>
                    Rua Azerbaijão, 89
                </p>

                <p>
                    (81) 4002-8922
                </p>
            </div>

        </section>

    </main>

</body>

</html>
